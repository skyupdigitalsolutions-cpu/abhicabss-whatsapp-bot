# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── PostgreSQL ───────────────────────────────────────────
# Local:  postgresql://postgres:password@127.0.0.1:5432/abhicabs_whatsapp
# Atlas/Railway/Supabase etc: use the connection string they give you
# This is a SEPARATE database from any existing ABHI CABS backend's
# Postgres — it only stores the bot's own conversation/session state
# (and local vehicle/fare/booking data if BACKEND_MODE=local). If you
# have a real backend, prefer BACKEND_MODE=remote instead of pointing
# this at the same database as that backend.
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/abhicabs_whatsapp

# ─── WhatsApp via MSG91 (BSP) ──────────────────────────────
# MSG91 sits in front of Meta and handles the WhatsApp Business
# relationship for you. Get these from your MSG91 dashboard:
#   MSG91_AUTH_KEY          -> top nav "AuthKey" (control.msg91.com)
#   MSG91_INTEGRATED_NUMBER -> WhatsApp > Number page, e.g. 918096000182
#   MSG91_WEBHOOK_SECRET    -> a random string YOU make up, then add it as a
#                              custom header (e.g. X-Webhook-Secret) when you
#                              create the webhook in WhatsApp > Webhook (New)
MSG91_AUTH_KEY=
MSG91_INTEGRATED_NUMBER=
MSG91_WEBHOOK_SECRET=

# ─── AI / Conversation Engine ─────────────────────────────
# Used ONLY for NLU (intent/entity extraction) and drafting replies.
# The AI NEVER calculates fares or confirms bookings/payments itself.
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# ─── ABHI CABS Backend ─────────────────────────────────────
# If ABHI CABS already has a separate website backend, point this at it
# and set BACKEND_MODE=remote. If this bot IS the backend (no separate
# system yet), set BACKEND_MODE=local and it uses the local Mongo models.
BACKEND_MODE=local
BACKEND_API_URL=https://api.abhicabs.example.com
BACKEND_API_KEY=

# ─── Razorpay ──────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Sessions / Conversation ───────────────────────────────
SESSION_TIMEOUT_MINUTES=30
ABANDONED_BOOKING_FOLLOWUP_MINUTES=45

# ─── Redis (optional, for distributed rate limiting/queues) ─
REDIS_URL=

# ─── Admin ─────────────────────────────────────────────────
ADMIN_API_KEY=change_me_admin_key

# --- Added for the full booking flow ---
# Google Distance Matrix API key (needed for correct fares on typed addresses)
GOOGLE_MAPS_API_KEY=
# Partial Payment = this % of the fare, paid now
PARTIAL_PAYMENT_PERCENT=25
# Shown to customers under "Contact Us"
SUPPORT_PHONE=+91 80960 00182
